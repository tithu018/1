generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STORE_MANAGER
  DISPATCHER
  LOADER
  DRIVER
}

enum Brand {
  FRESH
  STYLE
  TECH
}

enum VehicleType {
  TRUCK
  VAN
}

enum VehicleTemperature {
  AMBIENT
  REEFER
}

enum OrderStatus {
  SUBMITTED
  CONFIRMED
  ALLOCATED
  LOADED
  OUT_FOR_DELIVERY
  DELIVERED
  DEFERRED
  CANCELLED
}

enum PlanStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum IssueStatus {
  REPORTED
  ACKNOWLEDGED
  UNDER_REVIEW
  RESOLVED
  REOPENED
}

model Depot {
  id       String    @id
  name     String
  outlets  Outlet[]
  vehicles Vehicle[]
  plans    Plan[]
}

model Outlet {
  id                    String   @id
  brand                 Brand
  district              String
  depotId               String
  dockType              String
  parkingConstraint     String
  mallWindow            String?
  windowOpenTime        String
  windowCloseTime       String
  depot                 Depot    @relation(fields: [depotId], references: [id])
  accounts              Account[]
  orders                Order[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Vehicle {
  id                  String             @id
  depotId             String
  type                VehicleType
  temperature         VehicleTemperature
  weightCapacityKg    Decimal            @db.Decimal(12, 2)
  volumeCapacityM3    Decimal            @db.Decimal(12, 3)
  kilometersPerLitre  Decimal            @db.Decimal(8, 3)
  weeklyFuelQuotaL    Decimal            @db.Decimal(12, 2)
  isInWorkshop        Boolean            @default(false)
  depot               Depot              @relation(fields: [depotId], references: [id])
  trips               Trip[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model Account {
  id          String    @id @default(cuid())
  email       String    @unique
  displayName String
  passwordHash String
  role        Role
  outletId    String?
  depotId     String?
  locale      String    @default("en")
  outlet      Outlet?   @relation(fields: [outletId], references: [id])
  events      AuditEvent[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Order {
  id                  String       @id
  outletId            String
  requestedDate       DateTime
  status              OrderStatus  @default(SUBMITTED)
  temperatureRequired VehicleTemperature
  units               Int
  weightKg            Decimal      @db.Decimal(12, 2)
  volumeM3            Decimal      @db.Decimal(12, 3)
  submittedAt         DateTime?
  deliveryWindowOpen  String
  deliveryWindowClose String
  outlet              Outlet       @relation(fields: [outletId], references: [id])
  lines               OrderLine[]
  allocations         Allocation[]
  statusEvents        OrderStatusEvent[]
  issues              IssueCase[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model OrderLine {
  id          String  @id @default(cuid())
  orderId     String
  productCode String
  description String
  quantity    Int
  weightKg    Decimal @db.Decimal(12, 2)
  volumeM3    Decimal @db.Decimal(12, 3)
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Plan {
  id          String     @id @default(cuid())
  depotId     String
  serviceDate DateTime
  version     Int
  status      PlanStatus @default(DRAFT)
  publishedAt DateTime?
  depot       Depot      @relation(fields: [depotId], references: [id])
  trips       Trip[]
  allocations Allocation[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([depotId, serviceDate, version])
}

model Trip {
  id          String       @id @default(cuid())
  planId      String
  vehicleId   String
  tripNumber  Int
  brand       Brand
  district    String
  status      OrderStatus  @default(ALLOCATED)
  plannedStart DateTime?
  plan        Plan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  vehicle     Vehicle      @relation(fields: [vehicleId], references: [id])
  allocations Allocation[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([planId, vehicleId, tripNumber])
}

model Allocation {
  id         String @id @default(cuid())
  orderId    String
  planId     String
  tripId     String
  sequence   Int
  order      Order  @relation(fields: [orderId], references: [id])
  plan       Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  trip       Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([planId, orderId])
  @@unique([tripId, sequence])
}

model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  reason    String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model IssueCase {
  id        String      @id @default(cuid())
  orderId   String
  status    IssueStatus @default(REPORTED)
  summary   String
  order     Order       @relation(fields: [orderId], references: [id])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorId     String?
  entityType  String
  entityId    String
  action      String
  payload     Json?
  occurredAt  DateTime @default(now())
  actor       Account? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId, occurredAt])
}
