{
  "name": "waypoint",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "pnpm --filter @waypoint/web dev",
    "build": "pnpm --filter @waypoint/web build",
    "lint": "pnpm --filter @waypoint/web lint",
    "test": "pnpm --filter @waypoint/web test",
    "test:backend": "pnpm --filter @waypoint/web test:backend",
    "db:generate": "pnpm --filter @waypoint/database generate",
    "db:migrate": "pnpm --filter @waypoint/database migrate",
    "db:seed": "pnpm --filter @waypoint/database seed",
    "db:bootstrap": "pnpm --filter @waypoint/database bootstrap"
  }
}
